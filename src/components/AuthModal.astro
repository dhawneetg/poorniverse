---
// AuthModal.astro — Supabase Authentication & Google OAuth (Dark & Light Mode)
---

<div id="modal-auth" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden" data-modal="modal-auth">
  <div class="card-mobbin bg-white dark:bg-[#18181b] border border-[#e4e4e7] dark:border-[#27272a] w-full max-w-md p-6 sm:p-8 shadow-2xl space-y-6 relative z-10 opacity-100" onclick="event.stopPropagation()">
    <!-- Header with Segmented Switcher -->
    <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7] dark:border-[#27272a]">
      <div class="inline-flex p-1 bg-[#f3f3f3] dark:bg-[#27272a] rounded-full border border-[#e0e0e0] dark:border-[#3f3f46]">
        <button id="auth-tab-signin" class="auth-pill active px-4 py-1.5 rounded-full bg-[#141414] dark:bg-white text-white dark:text-[#141414] font-semibold text-xs transition-all">
          Sign In
        </button>
        <button id="auth-tab-signup" class="auth-pill px-4 py-1.5 rounded-full text-[#707070] dark:text-[#a1a1aa] hover:text-[#141414] dark:hover:text-white font-semibold text-xs transition-all">
          Create Account
        </button>
      </div>
      <button id="btn-close-auth-modal" class="text-[#707070] dark:text-[#a1a1aa] hover:text-[#141414] dark:hover:text-white p-1 text-xl font-bold">&times;</button>
    </div>

    <!-- Continue with Google Button -->
    <div class="space-y-4">
      <button 
        id="btn-google-auth" 
        class="w-full flex items-center justify-center gap-3 py-2.5 px-4 rounded-full border border-[#e0e0e0] dark:border-[#3f3f46] bg-white dark:bg-[#27272a] hover:bg-[#f8f9fa] dark:hover:bg-[#3f3f46] text-[#141414] dark:text-white font-semibold text-xs transition-all shadow-sm"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Continue with Google</span>
      </button>

      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-[#e0e0e0] dark:bg-[#27272a]"></div>
        <span class="text-[11px] text-[#adadad] dark:text-[#71717a] uppercase font-semibold">or email</span>
        <div class="flex-1 h-px bg-[#e0e0e0] dark:bg-[#27272a]"></div>
      </div>
    </div>

    <!-- PANEL 1: SIGN IN -->
    <div id="auth-panel-signin" class="space-y-4">
      <div>
        <h3 class="font-heading text-lg text-[#141414] dark:text-white">Sign in to your account.</h3>
        <p class="font-subheading text-xs mt-1 text-[#707070] dark:text-[#a1a1aa]">Access your saved attendance records and cloud preferences.</p>
      </div>

      <form id="form-signin" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-[#141414] dark:text-white mb-1">Poornima Student Email</label>
          <input type="email" id="signin-identifier" required placeholder="student@poornima.org" class="field-input w-full text-xs" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-[#141414] dark:text-white mb-1">Password</label>
          <input type="password" id="signin-password" required placeholder="••••••••" class="field-input w-full text-xs" />
        </div>
        <div class="flex items-center justify-between text-xs pt-1">
          <label class="flex items-center gap-2 text-[#707070] dark:text-[#a1a1aa] cursor-pointer">
            <input type="checkbox" checked class="rounded border-[#e0e0e0] dark:border-[#3f3f46] accent-[#141414] dark:accent-white" /> Remember on this device
          </label>
        </div>
        <div class="pt-2">
          <button type="submit" class="pill-primary w-full py-2.5 text-xs">
            Sign In
          </button>
        </div>
      </form>
    </div>

    <!-- PANEL 2: SIGN UP -->
    <div id="auth-panel-signup" class="space-y-4 hidden">
      <div>
        <h3 class="font-heading text-lg text-[#141414] dark:text-white">Create student profile.</h3>
        <p class="font-subheading text-xs mt-1 text-[#707070] dark:text-[#a1a1aa]">Set up your hostel room quotas and course timetable.</p>
      </div>

      <form id="form-signup" class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-[#141414] dark:text-white mb-1">Full Name</label>
            <input type="text" id="signup-name" required placeholder="Dhawneet" class="field-input w-full text-xs" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#141414] dark:text-white mb-1">Roll / Reg Number</label>
            <input type="text" id="signup-roll" required placeholder="2024PCECS042" class="field-input w-full text-xs" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-[#141414] dark:text-white mb-1">Department</label>
            <select id="signup-dept" class="field-input w-full text-xs">
              <option value="CSE">Computer Science & Engg</option>
              <option value="AI">AI & Data Science</option>
              <option value="ECE">Electronics & Comm</option>
              <option value="ME">Mechanical / Civil</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-[#141414] dark:text-white mb-1">Student Type</label>
            <select id="signup-type" class="field-input w-full text-xs">
              <option value="Hosteller">Hosteller (Laundry + AC)</option>
              <option value="Day Scholar">Day Scholar</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#141414] dark:text-white mb-1">College Email</label>
          <input type="email" id="signup-email" required placeholder="student@poornima.org" class="field-input w-full text-xs" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#141414] dark:text-white mb-1">Create Password</label>
          <input type="password" id="signup-password" required placeholder="Minimum 6 characters" class="field-input w-full text-xs" />
        </div>

        <div class="pt-2">
          <button type="submit" class="pill-primary w-full py-2.5 text-xs">
            Create Profile
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
