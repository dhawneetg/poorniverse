---
// SettingsModal.astro — Minimal Settings & Environment Status (Keys managed securely in .env)
---

<div id="modal-settings" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden" data-modal="modal-settings">
  <div class="card-mobbin bg-white dark:bg-[#18181b] border border-[#e4e4e7] dark:border-[#27272a] w-full max-w-lg p-6 sm:p-8 shadow-2xl space-y-6 relative z-10 opacity-100" onclick="event.stopPropagation()">
    <div class="flex items-center justify-between pb-3 border-b border-[#e4e4e7] dark:border-[#27272a]">
      <div>
        <h3 class="font-heading text-lg text-[#09090b] dark:text-white">Settings & Cloud Status</h3>
        <p class="font-caption text-xs text-[#52525b] dark:text-[#a1a1aa]">Institution environment and cloud connection</p>
      </div>
      <button id="btn-close-settings-modal" class="text-[#71717a] dark:text-[#a1a1aa] hover:text-[#09090b] dark:hover:text-white p-1 text-xl font-bold">&times;</button>
    </div>

    <!-- Secure Cloud Environment Overview -->
    <div class="space-y-3">
      <div class="p-4 rounded-2xl card-inner-well space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#047857] dark:bg-[#34d399] animate-pulse"></span>
            <span class="font-heading text-xs text-[#09090b] dark:text-white">Cloud Database Sync</span>
          </div>
          <span id="settings-db-status" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#ecfdf5] dark:bg-[#064e3b] text-[#047857] dark:text-[#34d399] border border-[#a7f3d0] dark:border-[#065f46]">
            Active
          </span>
        </div>
        <p class="text-[11px] text-[#52525b] dark:text-[#a1a1aa] leading-relaxed">
          PostgreSQL persistence layer is operational. Changes made across TCS iON attendance, hostel meters, and tasks are automatically synchronized with offline encrypted localStorage fallback.
        </p>
      </div>

      <div class="p-4 rounded-2xl card-inner-well space-y-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#0066ff] dark:bg-[#60a5fa]"></span>
            <span class="text-xs font-semibold text-[#09090b] dark:text-white">Google Gemini AI Engine</span>
          </div>
          <span class="text-[10px] font-semibold px-2.5 py-0.5 rounded-full bg-[#eff6ff] dark:bg-[#172554] text-[#0066ff] dark:text-[#60a5fa] border border-[#bfdbfe] dark:border-[#1e3a8a]">
            Configured (.env)
          </span>
        </div>
        <div class="text-[11px] text-[#52525b] dark:text-[#a1a1aa] leading-relaxed">
          Smart outfit suggestions and academic attendance advice are powered by your server environment key.
        </div>
      </div>
    </div>

    <!-- Data Management & Backup -->
    <div class="pt-4 border-t border-[#e4e4e7] dark:border-[#27272a] space-y-3">
      <h4 class="text-xs font-semibold text-[#09090b] dark:text-white">Local Data & Device Backup</h4>
      <div class="grid grid-cols-2 gap-3 text-xs">
        <button id="btn-export-json" class="pill-outline text-xs">
          <span>Export JSON Backup</span>
        </button>
        <button id="btn-reset-defaults" class="pill-soft text-xs text-[#b91c1c] dark:text-[#f87171] hover:bg-[#fef2f2] dark:hover:bg-[#450a0a]">
          <span>Reset Sample Cache</span>
        </button>
      </div>
      <p class="text-[10px] text-[#71717a] dark:text-[#71717a]">
        Export saves an offline backup of all courses, laundry tokens, wardrobe items, and tasks.
      </p>
    </div>

    <div class="flex justify-end pt-2 border-t border-[#e4e4e7] dark:border-[#27272a]">
      <button id="btn-close-settings-done" class="pill-primary text-xs">
        Close
      </button>
    </div>
  </div>
</div>
