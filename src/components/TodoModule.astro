---
// TodoModule.astro — Dark Mode Harmonized Dual-Track Academic Tasks & Project Folders
---

<div class="card-mobbin p-6 sm:p-8 space-y-6">
  <!-- Master Mode Switch: Academic/Daily vs Folder-Wise Projects -->
  <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-[#e0e0e0] dark:border-[#27272a]">
    <div>
      <h3 class="font-heading text-xl text-[#141414] dark:text-white" id="todo-main-heading">Academic Tasks & Deadlines</h3>
      <p class="font-caption text-xs text-[#707070] dark:text-[#a1a1aa]" id="todo-main-subtext">Manage today's routines, upcoming exam & assignment deadlines, and custom project folders</p>
    </div>

    <!-- Master Mode Tabs -->
    <div class="inline-flex p-1 bg-[#f3f3f3] dark:bg-[#27272a] rounded-full border border-[#e0e0e0] dark:border-[#3f3f46]">
      <button 
        id="btn-mode-academic" 
        class="task-master-tab active px-4 py-1.5 rounded-full bg-[#141414] dark:bg-white text-white dark:text-[#141414] font-semibold text-xs transition-all flex items-center gap-1.5"
        data-mode="academic"
      >
        <span>⚡ Daily & Deadlines</span>
      </button>
      <button 
        id="btn-mode-folders" 
        class="task-master-tab px-4 py-1.5 rounded-full text-[#707070] dark:text-[#a1a1aa] hover:text-[#141414] dark:hover:text-white font-medium text-xs transition-all flex items-center gap-1.5"
        data-mode="folders"
      >
        <span>📁 Project Folders</span>
      </button>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- VIEW 1: ACADEMIC TASKS & DEADLINES (Today, Just Tasks, Important) -->
  <!-- ============================================================== -->
  <div id="view-academic-tasks" class="space-y-6">
    <!-- Sub-Filter Bar (Today vs Just Tasks vs Important) -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <!-- Scope Tabs -->
      <div class="inline-flex p-1 bg-[#f3f3f3] dark:bg-[#27272a] rounded-full border border-[#e0e0e0] dark:border-[#3f3f46] text-xs">
        <button class="todo-scope-btn active px-3.5 py-1.5 rounded-full bg-[#141414] dark:bg-white text-white dark:text-[#141414] font-semibold transition-all" data-scope="today">
          📌 Today's Tasks (<span id="todo-count-today">0</span>)
        </button>
        <button class="todo-scope-btn px-3.5 py-1.5 rounded-full text-[#707070] dark:text-[#a1a1aa] hover:text-[#141414] dark:hover:text-white font-medium transition-all" data-scope="tasks">
          📋 Just Tasks / Deadlines (<span id="todo-count-just-tasks">0</span>)
        </button>
        <button class="todo-scope-btn px-3.5 py-1.5 rounded-full text-[#707070] dark:text-[#a1a1aa] hover:text-[#141414] dark:hover:text-white font-medium transition-all" data-scope="important">
          ⭐ Important (<span id="todo-count-important">0</span>)
        </button>
      </div>

      <!-- Category Filter (Visible in Just Tasks mode) -->
      <div id="todo-category-filters" class="hidden sm:inline-flex items-center gap-1 text-xs">
        <button class="todo-cat-btn active px-2.5 py-1 rounded-lg bg-[#141414] dark:bg-white text-white dark:text-[#141414] font-medium" data-cat="all">All</button>
        <button class="todo-cat-btn px-2.5 py-1 rounded-lg text-[#707070] dark:text-[#a1a1aa] hover:bg-[#f3f3f3] dark:hover:bg-[#27272a] font-medium" data-cat="assignment">Assignments</button>
        <button class="todo-cat-btn px-2.5 py-1 rounded-lg text-[#707070] dark:text-[#a1a1aa] hover:bg-[#f3f3f3] dark:hover:bg-[#27272a] font-medium" data-cat="exam">Exams</button>
        <button class="todo-cat-btn px-2.5 py-1 rounded-lg text-[#707070] dark:text-[#a1a1aa] hover:bg-[#f3f3f3] dark:hover:bg-[#27272a] font-medium" data-cat="lab">Lab Files</button>
        <button class="todo-cat-btn px-2.5 py-1 rounded-lg text-[#707070] dark:text-[#a1a1aa] hover:bg-[#f3f3f3] dark:hover:bg-[#27272a] font-medium" data-cat="general">Personal</button>
      </div>
    </div>

    <!-- Today's Progress Banner (Shown when scope is 'today') -->
    <div id="today-progress-banner" class="p-4 rounded-2xl card-inner-well flex flex-wrap items-center justify-between gap-3">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="font-heading text-sm text-[#141414] dark:text-white">Today's Focus & Habits</span>
          <span id="today-progress-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#047857]/10 dark:bg-[#34d399]/10 text-[#047857] dark:text-[#34d399]">
            0% Done
          </span>
        </div>
        <p class="text-[11px] text-[#707070] dark:text-[#a1a1aa]">Daily recurring tasks reset automatically every midnight</p>
      </div>
      <div class="w-full sm:w-48 bg-[#e0e0e0] dark:bg-[#3f3f46] h-2 rounded-full overflow-hidden">
        <div id="today-progress-bar" class="bg-[#141414] dark:bg-white h-full transition-all duration-300" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Quick Add Task Bar -->
    <form id="form-add-todo" class="p-4 rounded-2xl card-inner-well space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <input 
          type="text" 
          id="todo-input-title" 
          placeholder="Add a task (e.g. Check TCS Attendance, Complete DSA Assignment)..." 
          class="field-input flex-1 min-w-[220px] text-xs"
          required
        />
        <select id="todo-input-category" class="field-input text-xs">
          <option value="assignment">Assignment</option>
          <option value="exam">Mid-Term / Exam</option>
          <option value="lab">Lab File</option>
          <option value="general" selected>Personal / Habit</option>
        </select>
        <select id="todo-input-priority" class="field-input text-xs">
          <option value="high">High Priority</option>
          <option value="medium" selected>Medium</option>
          <option value="low">Low</option>
        </select>
        <input 
          type="date" 
          id="todo-input-due" 
          class="field-input text-xs"
        />
        <button type="submit" class="pill-primary text-xs whitespace-nowrap">
          Add Task
        </button>
      </div>

      <!-- Quick Toggles & Date Shortcuts -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-1 text-xs">
        <div class="flex items-center gap-2">
          <!-- Daily Habit Toggle -->
          <label class="inline-flex items-center gap-1.5 cursor-pointer select-none text-[11px] text-[#707070] dark:text-[#a1a1aa] hover:text-[#141414] dark:hover:text-white">
            <input type="checkbox" id="todo-toggle-daily" class="w-3.5 h-3.5 rounded border-[#e0e0e0] dark:border-[#3f3f46] accent-[#141414] dark:accent-white" />
            <span>🔁 Daily Habit (Resets midnight)</span>
          </label>
          <span class="text-[#e0e0e0] dark:text-[#3f3f46]">•</span>
          <!-- Important Toggle -->
          <label class="inline-flex items-center gap-1.5 cursor-pointer select-none text-[11px] text-[#707070] dark:text-[#a1a1aa] hover:text-[#141414] dark:hover:text-white">
            <input type="checkbox" id="todo-toggle-important" class="w-3.5 h-3.5 rounded border-[#e0e0e0] dark:border-[#3f3f46] accent-[#b45309] dark:accent-[#facc15]" />
            <span class="flex items-center gap-0.5">⭐ Star as Important</span>
          </label>
        </div>

        <!-- Quick Date Chips -->
        <div class="inline-flex items-center gap-1 text-[10px]">
          <span class="text-[#707070] dark:text-[#a1a1aa]">Due:</span>
          <button type="button" class="btn-quick-due px-2 py-0.5 rounded-md bg-[#e0e0e0] dark:bg-[#3f3f46] text-[#141414] dark:text-white hover:opacity-80 transition-all" data-days="0">Today</button>
          <button type="button" class="btn-quick-due px-2 py-0.5 rounded-md bg-[#e0e0e0] dark:bg-[#3f3f46] text-[#141414] dark:text-white hover:opacity-80 transition-all" data-days="1">Tomorrow</button>
          <button type="button" class="btn-quick-due px-2 py-0.5 rounded-md bg-[#e0e0e0] dark:bg-[#3f3f46] text-[#141414] dark:text-white hover:opacity-80 transition-all" data-days="7">Next Week</button>
        </div>
      </div>
    </form>

    <!-- Tasks List Container -->
    <div id="todos-container" class="space-y-3 pt-2">
      <!-- Populated dynamically in app.ts -->
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- VIEW 2: FOLDER-WISE PROJECT TASKS (Completely Isolated Feature) -->
  <!-- ============================================================== -->
  <div id="view-folder-tasks" class="hidden space-y-6">
    <!-- Folder Bar / Pills & New Folder Action -->
    <div class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-2xl card-inner-well">
      <div class="flex items-center gap-2 overflow-x-auto pb-1 max-w-full" id="task-folder-pills">
        <!-- Injected dynamically in app.ts -->
      </div>
      <button id="btn-create-folder" class="pill-soft text-xs py-1.5 px-3 flex items-center gap-1.5 whitespace-nowrap">
        <span>+ New Folder</span>
      </button>
    </div>

    <!-- Active Folder Card Header -->
    <div class="p-5 rounded-2xl border border-[#e0e0e0] dark:border-[#27272a] bg-[#fafafa] dark:bg-[#1c1c1f] space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span id="active-folder-icon" class="text-2xl">📁</span>
          <div>
            <h4 id="active-folder-name" class="font-heading text-lg text-[#141414] dark:text-white">Project Folder</h4>
            <p id="active-folder-stats" class="text-xs text-[#707070] dark:text-[#a1a1aa]">0 tasks • 0 completed</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <div class="w-28 sm:w-36 bg-[#e0e0e0] dark:bg-[#3f3f46] h-2 rounded-full overflow-hidden">
            <div id="active-folder-progress" class="bg-[#8b5cf6] h-full transition-all duration-300" style="width: 0%;"></div>
          </div>
          <button id="btn-delete-active-folder" class="text-xs text-[#adadad] dark:text-[#71717a] hover:text-[#b91c1c] p-1 transition-colors" title="Delete this folder">
            Delete
          </button>
        </div>
      </div>

      <!-- Add Task to Active Folder Form -->
      <form id="form-add-folder-task" class="flex flex-wrap items-center gap-2 pt-2 border-t border-[#e0e0e0] dark:border-[#27272a]">
        <input 
          type="text" 
          id="folder-task-input-title" 
          placeholder="Add task to this folder (e.g. Implement player jump physics)..." 
          class="field-input flex-1 min-w-[200px] text-xs"
          required
        />
        <select id="folder-task-input-priority" class="field-input text-xs">
          <option value="high">High Priority</option>
          <option value="medium" selected>Medium</option>
          <option value="low">Low</option>
        </select>
        <button type="submit" class="pill-primary text-xs whitespace-nowrap">
          Add Task
        </button>
      </form>
    </div>

    <!-- Active Folder Tasks Container -->
    <div id="folder-tasks-container" class="space-y-3">
      <!-- Injected dynamically in app.ts -->
    </div>
  </div>
</div>

