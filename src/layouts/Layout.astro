---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Poornima Companion — College Suite & Hostel Quota OS",
  description = "All-in-one productivity suite for Poornima College students: 75% TCS iON Attendance Bunk Calculator, 60-Wash Laundry Token Optimizer, Wardrobe Assistant, 1000-Unit AC Tracker & Academic To-Do List."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <!-- Modern Google Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- Inline Theme Script to prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[#f8f9fa] dark:bg-[#09090b] text-[#09090b] dark:text-[#f4f4f5] antialiased selection:bg-blue-500/20 selection:text-blue-600 transition-colors duration-200">
    <slot />
  </body>
</html>
