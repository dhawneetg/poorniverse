---
// index.astro — Enhanced Mobbin Poornima Companion Suite
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import AttendanceModule from '../components/AttendanceModule.astro';
import HostelQuotasModule from '../components/HostelQuotasModule.astro';
import TodoModule from '../components/TodoModule.astro';
import CampusToolsModule from '../components/CampusToolsModule.astro';
import SettingsModal from '../components/SettingsModal.astro';
import AuthModal from '../components/AuthModal.astro';
import ExtensionModal from '../components/ExtensionModal.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col bg-[#f8f9fa] dark:bg-[#09090b] text-[#09090b] dark:text-[#f4f4f5] transition-colors duration-200 pb-24 md:pb-8">
    <Header />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <!-- VIEW 1: Attendance Module -->
      <section id="view-attendance" class="view-section">
        <AttendanceModule />
      </section>

      <!-- VIEW 2: Hostel Quotas Module (Laundry & AC) -->
      <section id="view-hostel" class="view-section hidden">
        <HostelQuotasModule />
      </section>

      <!-- VIEW 3: To-Do Module -->
      <section id="view-todos" class="view-section hidden">
        <TodoModule />
      </section>

      <!-- VIEW 4: Campus Tools (SGPA & Mess) -->
      <section id="view-tools" class="view-section hidden">
        <CampusToolsModule />
      </section>
    </main>

    <!-- Global Modals -->
    <AuthModal />
    <ExtensionModal />
    <SettingsModal />

    <!-- Enhanced Multi-Column Full-Bleed Mobbin Footer (24px Top Corners) -->
    <footer class="bg-[#141414] dark:bg-[#121215] border-t border-transparent dark:border-[#27272a] text-white rounded-t-[24px] pt-14 pb-12 mt-20 transition-colors">
      <div class="max-w-7xl mx-auto px-6 sm:px-8 space-y-12">
        <!-- Main Footer Links Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
          <!-- Col 1: Institutional Monogram & Overview -->
          <div class="lg:col-span-2 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-sky-500 via-blue-600 to-indigo-700 shadow-lg shadow-blue-500/20 border border-white/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 21V4h6.5a4.5 4.5 0 0 1 4.5 4.5v0a4.5 4.5 0 0 1-4.5 4.5H7" />
                  <circle cx="13" cy="8.5" r="1.25" fill="currentColor" stroke="none" />
                </svg>
              </div>
              <div>
                <div class="font-heading text-base text-white">Poornima College of Engineering</div>
                <div class="font-caption text-xs text-[#707070] dark:text-[#a1a1aa]">Dept of Computer Science & Engineering (PCE Jaipur)</div>
              </div>
            </div>
            <p class="font-subheading text-xs text-[#adadad] dark:text-[#a1a1aa] leading-relaxed max-w-sm">
              An institutional operating suite engineered for undergraduate engineering students. Automates TCS iON digital attendance validation, hostel 60-wash laundry rationing, 1000-unit AC electricity quotas, and semester academic deadlines.
            </p>
            <div class="text-[11px] text-[#707070] dark:text-[#71717a] pt-1">
              Campus: ISI-6, RIICO Institutional Area, Sitapura, Jaipur, Rajasthan 302022
            </div>
          </div>

          <!-- Col 2: Academic & Attendance Modules -->
          <div class="space-y-3">
            <h4 class="font-heading text-xs uppercase tracking-wider text-white">Academic Modules</h4>
            <ul class="space-y-2 text-xs text-[#adadad] dark:text-[#a1a1aa]">
              <li><button class="footer-nav-btn hover:text-white transition-colors text-left" data-view="attendance">TCS iON Attendance Engine</button></li>
              <li><button class="footer-nav-btn hover:text-white transition-colors text-left" data-view="attendance">75% Safe Bunk Calculator</button></li>
              <li><button class="footer-nav-btn hover:text-white transition-colors text-left" data-view="attendance">Attendance Recovery Forecaster</button></li>
              <li><button class="footer-nav-btn hover:text-white transition-colors text-left" data-view="tools">SGPA & Internal Marks Target</button></li>
              <li><a href="https://pce.poornima.org/academics/time-table" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Course Timetable & Labs ↗</a></li>
              <li><a href="https://lms.poornima.edu.in" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Previous Exam Question Bank ↗</a></li>
            </ul>
          </div>

          <!-- Col 3: Hostel Living & Quotas -->
          <div class="space-y-3">
            <h4 class="font-heading text-xs uppercase tracking-wider text-white">Hostel & Amenities</h4>
            <ul class="space-y-2 text-xs text-[#adadad] dark:text-[#a1a1aa]">
              <li><button class="footer-nav-btn hover:text-white transition-colors text-left" data-view="hostel">60-Wash Laundry Token Budget</button></li>
              <li><button class="footer-nav-btn hover:text-white transition-colors text-left" data-view="hostel">1000-Unit AC Consumption Meter</button></li>
              <li><button class="footer-nav-btn hover:text-white transition-colors text-left" data-view="hostel">Smart Dirty Cloth Accumulator</button></li>
              <li><button class="footer-nav-btn hover:text-white transition-colors text-left" data-view="hostel">Wardrobe & Outfit Suggester</button></li>
              <li><button class="footer-nav-btn hover:text-white transition-colors text-left" data-view="tools">Daily Hostel Mess Schedule</button></li>
              <li><a href="https://poornima.edu.in/life-at-poornima/menu-facility" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Official Mess Menu Facility ↗</a></li>
            </ul>
          </div>

          <!-- Col 4: Extension & Technology -->
          <div class="space-y-3">
            <h4 class="font-heading text-xs uppercase tracking-wider text-white">Integrations & Tech</h4>
            <ul class="space-y-2 text-xs text-[#adadad] dark:text-[#a1a1aa]">
              <li><button id="footer-btn-ext" class="hover:text-white transition-colors text-left">Chrome Extension V3</button></li>
              <li><button id="footer-btn-bm" class="hover:text-white transition-colors text-left">1-Click TCS Bookmarklet</button></li>
              <li><button id="footer-btn-sync" class="hover:text-white transition-colors text-left">Supabase PostgreSQL Bridge</button></li>
              <li><button id="footer-btn-settings" class="hover:text-white transition-colors text-left">LocalStorage Encrypted Cache</button></li>
              <li><button id="footer-btn-backup" class="hover:text-white transition-colors text-left">Export Full JSON Backup</button></li>
            </ul>
          </div>
        </div>

        <!-- Bottom Legal & Status Bar -->
        <div class="pt-8 border-t border-[#262626] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#707070] dark:text-[#a1a1aa]">
          <div class="flex items-center gap-3">
            <span>© 2026 Poornima Companion OS</span>
            <span>•</span>
            <span>Built for PCE Jaipur B.Tech Students</span>
            <span>•</span>
            <span class="text-[#047857] dark:text-[#34d399]">All systems operational</span>
          </div>

          <div class="flex items-center gap-5 text-[#adadad] dark:text-[#a1a1aa]">
            <a href="https://www.tcsion.com/SelfServices/" target="_blank" rel="noopener noreferrer" class="hover:text-white">TCS iON Portal ↗</a>
            <a href="https://pce.poornima.org" target="_blank" rel="noopener noreferrer" class="hover:text-white">Poornima PCE ↗</a>
            <a href="https://poornima.edu.in/life-at-poornima/menu-facility" target="_blank" rel="noopener noreferrer" class="hover:text-white">Live Mess Menu ↗</a>
            <span class="text-[#707070] dark:text-[#71717a]">v2.5.0 Production</span>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <script>
    import { initApp } from '../scripts/app';
    document.addEventListener('DOMContentLoaded', () => {
      initApp();
    });
  </script>
</Layout>
